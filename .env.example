# Copy to .env and fill in. Loaded by python-dotenv at startup.

# JWT signing key — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=change-me

# Postgres DSN for mayim
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/app

# Security battery (see README)
SECURITY_HEADERS=true
# Comma-separated allowlist; leave unset to disable Host-header checks locally
# TRUSTED_HOSTS=api.example.com,*.example.com

# Redis-backed sessions (see README "Sessions" section). Off unless URL is set.
# REDIS_URL=redis://localhost:6379/0

# Prometheus /metrics endpoint (requires: uv sync --extra metrics). Off by default.
# METRICS_ENABLED=true
# Per-worker deep-dive series (sanic_worker_request_*), on when metrics are enabled
# METRICS_PER_WORKER=true
# Required for multi-worker runs so metrics aggregate across workers (empty dir!)
# PROMETHEUS_MULTIPROC_DIR=/tmp/prom-multiproc
